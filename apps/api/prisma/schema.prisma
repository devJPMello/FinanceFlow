generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {

  
  CHECKING
  CREDIT_CARD
  CASH
  INVESTMENT
}
enum CategoryKind {

  
  INCOME
  EXPENSE
}
enum TransactionType {

  
  INCOME
  EXPENSE
  TRANSFER
}
enum ImportFormat {

  
  CSV
  XLSX
  OFX
}
enum ImportStatus {

  
  UPLOADED
  MAPPED
  CONFIRMED
  REVERTED
}
enum ImportRowStatus {

  
  PENDING
  DUPLICATE
  ERROR
  IMPORTED
}
enum RuleMatch {

  
  CONTAINS
  REGEX
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  refreshTokens RefreshToken[]
  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  imports       ImportBatch[]
  rules         CategoryRule[]
  recurring     RecurringRule[]
  attachments   Attachment[]
  resetTokens   PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  initialBalance Decimal     @default(0) @db.Decimal(14, 2)
  currency       String      @default("BRL")
  createdAt      DateTime    @default(now())
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurring      RecurringRule[]
  @@index([userId])
}

model Category {
  id           String       @id @default(cuid())
  userId       String
  name         String
  kind         CategoryKind
  color        String       @default("#6366f1")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  rules        CategoryRule[]
  recurring    RecurringRule[]
  @@unique([userId, name, kind])
}

model Transaction {
  id            String          @id @default(cuid())
  userId        String
  accountId     String
  categoryId    String?
  type          TransactionType
  amount        Decimal         @db.Decimal(14, 2)
  date          DateTime        @db.Date
  description   String
  notes         String?
  hash          String
  externalId    String?
  importBatchId String?
  tags          String[]        @default([])
  paymentMethod PaymentMethod?
  installmentNo    Int?
  installmentTotal Int?
  recurringId   String?
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  recurring     RecurringRule?  @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  attachments   Attachment[]
  @@index([userId, date])
  @@index([userId, paymentMethod])
  @@index([userId, accountId, date])
  @@index([userId, hash])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  month      String
  amount     Decimal  @db.Decimal(14, 2)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@unique([userId, categoryId, month])
}

model ImportBatch {
  id           String       @id @default(cuid())
  userId       String
  accountId    String?
  fileName     String
  format       ImportFormat
  status       ImportStatus @default(UPLOADED)
  mapping      Json?
  rawRows      Json
  totalRows    Int          @default(0)
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rows         ImportRow[]
  transactions Transaction[]
  @@index([userId])
}

model ImportRow {
  id          String          @id @default(cuid())
  batchId     String
  index       Int
  date        DateTime?       @db.Date
  description String?
  amount      Decimal?        @db.Decimal(14, 2)
  type        TransactionType?
  categoryId  String?
  hash        String?
  externalId  String?
  status      ImportRowStatus @default(PENDING)
  error       String?
  skip        Boolean         @default(false)
  batch       ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  @@index([batchId])
}

enum PaymentMethod {
  PIX
  DEBIT
  CREDIT
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringRule {
  id             String          @id @default(cuid())
  userId         String
  accountId      String
  categoryId     String?
  type           TransactionType
  amount         Decimal         @db.Decimal(14, 2)
  description    String
  paymentMethod  PaymentMethod?
  frequency      Frequency
  startDate      DateTime        @db.Date
  endDate        DateTime?       @db.Date
  nextDate       DateTime        @db.Date
  generatedCount Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  @@index([userId, active, nextDate])
}

model Attachment {
  id            String      @id @default(cuid())
  userId        String
  transactionId String
  fileName      String
  mime          String
  size          Int
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  @@index([transactionId])
}

model CategoryRule {
  id         String    @id @default(cuid())
  userId     String
  pattern    String
  matchType  RuleMatch @default(CONTAINS)
  categoryId String
  priority   Int       @default(0)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}
