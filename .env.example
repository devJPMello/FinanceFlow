DATABASE_URL=postgresql://financeflow:financeflow@localhost:5434/financeflow?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
PORT=3000
WEB_ORIGIN=http://localhost:5173

# E-mail (recuperação de senha). Sem SMTP_HOST o link é apenas exibido no log da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FinanceFlow <no-reply@seudominio.com>"
